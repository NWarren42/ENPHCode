subplot(2, 1, 1)
plot(Vm(1:5000, 1), Vm(1:5000, 2))
title("Input Voltage to SRV-02 Over Time")
ylabel("Input Voltage [V]")
xlabel("Time [s]")

subplot(2, 1, 2)
plot(wl(1:5000, 1), wl(1:5000, 2), wl(1:5000, 1), wl(:, 3))
ylim([0, 30])

title("First Order System Output Compared to Actual SRV-02 Dynamics")
ylabel("Angular Frequency [rad/s]")
xlabel("Time [s]")

legend(["Measured Angular Velocity", "Control Signal Input"])